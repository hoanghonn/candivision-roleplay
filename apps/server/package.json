{
  "name": "@roleplay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--experimental-sqlite --disable-warning=ExperimentalWarning\" tsx watch --env-file=../../.env src/main.ts",
    "start": "NODE_OPTIONS=\"--experimental-sqlite --disable-warning=ExperimentalWarning\" tsx --env-file-if-exists=../../.env src/main.ts",
    "test": "NODE_OPTIONS=\"--experimental-sqlite --disable-warning=ExperimentalWarning\" vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
