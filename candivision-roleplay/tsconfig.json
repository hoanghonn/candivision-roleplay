{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "paths": {
      "@roleplay/core": [
        "../packages/core/src/index.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ]
}
